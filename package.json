{
  "name": "maya-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Maya CRM — backend NestJS y frontend Angular SSR desplegados en Coolify.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
